# =====================================================================
# JudolGuard - template variabel lingkungan
# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN commit ".env".
# Panduan pengisian lengkap ada di README.md (bagian "Mengisi .env").
# =====================================================================

# ---------- 1. Flask (Part 1) ----------
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
# Kunci tanda tangan sesi Flask (string acak 64 karakter hex)
SECRET_KEY=
# Kunci Fernet untuk mengenkripsi refresh token OAuth di database (Part 3)
FERNET_KEY=

# ---------- 2. Google OAuth & YouTube Data API v3 (Part 2 & 4) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
# Batas maksimum komentar yang diambil per satu kali klik "Scan"
MAX_COMMENTS_PER_SCAN=2000
MAX_COMMENT_PAGES_PER_SCAN=20
# Batas maksimum video yang disinkronkan saat daftar video diperbarui
MAX_VIDEOS_PER_SYNC=500
# Batas video baru dan halaman playlist pada incremental sync
MAX_NEW_VIDEOS_PER_SYNC=100
MAX_INCREMENTAL_PAGES=10

# ---------- 3. Supabase PostgreSQL - Session Mode Pooler (Part 3) ----------
# Supabase > Connect > Session pooler (port 5432), contoh:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Masa retensi data komentar (hari), PRD 14.2
DATA_RETENTION_DAYS=30

# ---------- 4. LLM: Gemini utama, Groq cadangan (Part 7 & 8) ----------
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
